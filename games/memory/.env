# Memory — .env
# Copy this file to .env and tune. All values are optional; defaults are
# in `config.rs`.

# --- Window ---
WINDOW_W=900
WINDOW_H=700
HUD_H=50
FOOTER_H=30

# --- Board layout ---
BOARD_MARGIN=20
CARD_GAP=8
CARD_RADIUS=6
NO_MATCH_DELAY=0.8

# --- Colors (terminal theme) ---
# Format: COLOR_<NAME>_R, _G, _B, _A — each a f32 in [0.0, 1.0].
COLOR_BG_R=0.06
COLOR_BG_G=0.07
COLOR_BG_B=0.09
COLOR_BG_A=1.0

