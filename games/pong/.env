# Pong overrides. The game's values live in scenes/pong.escene (open it
# with the editor); a variable set here wins over the scene.
# Every line below is commented out and shows the scene's value.

# Court (the window size)
# SCREEN_WIDTH=800
# SCREEN_HEIGHT=600

# Paddles (both at once)
# PADDLE_WIDTH=15
# PADDLE_HEIGHT=80
# PLAYER_SPEED=350
# AI_SPEED=300

# Ball
# BALL_SIZE=20
# BALL_SPEED=600
# BALL_MAX_SPEED=1000
# BALL_SPEED_INCREMENT=1.05

# Colours (RGBA from 0.0 to 1.0): PLAYER_COLOR_*, AI_COLOR_*, BALL_COLOR_*
# BALL_COLOR_R=0.7
# BALL_COLOR_G=0.0
# BALL_COLOR_B=1.0
# BALL_COLOR_A=1.0

# Match
# WIN_SCORE=5
# AI_REACTION_TIME=0.08
# SERVE_ANGLE_MAX=0.4
# PADDLE_VELOCITY_FACTOR=0.3
